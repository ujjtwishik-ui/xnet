PORT=3000
NODE_ENV=development

# Строка подключения к Postgres
DATABASE_URL=postgres://user:password@localhost:5432/xnet

# off | relaxed | strict. Для облачной БД ставьте strict, если провайдер даёт валидный сертификат
DATABASE_SSL=off

# Длинная случайная строка (минимум 32 символа). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# За прокси (Render, Heroku, nginx) поставьте 1
# TRUST_PROXY=1
